{
  "name": "charter-life-demo",
  "productName": "Charter Life Demo",
  "version": "0.24",
  "main": "main.js",
  "private": true,
  "description": "Charter Life desktop wrapper",
  "scripts": {
    "prepare-app": "node copy-app.js",
    "start": "node copy-app.js && electron .",
    "dist": "node copy-app.js && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.charterlife.demo",
    "productName": "Charter Life Demo",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "app/icon-512.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "app/icon-512.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "app/icon-512.png"
    }
  }
}